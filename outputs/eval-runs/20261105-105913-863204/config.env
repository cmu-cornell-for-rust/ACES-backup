GROUP=/ocean/projects/cis260383p/shared/ACES-backup
MODE=bsan
IMAGE=experimental-bsan
SIF_ABS=/ocean/projects/cis260383p/shared/ACES-backup/containers/experimental-bsan.sif
DATASET_DIR=/ocean/projects/cis260383p/shared/ACES-backup/datasets/suspect-fps-bsan
DOWNLOAD=1
CPUS_PER_TASK=1
MEM_PER_TASK=8
TEST_THREADS=''
PARALLEL_TESTS=1
TEST_TIMEOUT=30m
TIMEOUT_STREAK=5
DEFAULT_FEATURES=0
MIRIFLAGS_ALL=''
BSAN_OPTIONS_ALL=stacktrace_max_len=10
BSAN_SYMBOLIZER=/opt/rust/rustup/toolchains/bsan/bin/llvm-symbolizer
MASTER_CSV=/ocean/projects/cis260383p/shared/ACES-backup/outputs/experimental-bsan-suspect-fps-bsan-eval.csv
