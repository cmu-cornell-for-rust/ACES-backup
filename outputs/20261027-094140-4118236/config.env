GROUP=/scratch/group/p.cis260229.000
MODE=miri
IMAGE=master-miri
SIF_ABS=/scratch/group/p.cis260229.000/containers/master-miri.sif
DATASET_DIR=/scratch/group/p.cis260229.000/datasets/bugs
DOWNLOAD=1
CPUS_PER_TASK=1
MEM_PER_TASK=8
TEST_THREADS=''
TEST_TIMEOUT=30m
MIRIFLAGS_ALL=-Zmiri-disable-alignment-check\ -Zmiri-disable-data-race-detector\ -Zmiri-ignore-leaks\ -Zmiri-tree-borrows\ -Zmiri-disable-isolation
BSAN_OPTIONS_ALL=''
BSAN_SYMBOLIZER=/root/.rustup/toolchains/bsan/bin/llvm-symbolizer
MASTER_CSV=/scratch/group/p.cis260229.000/outputs/master-miri-Zmiri-disable-isolation-bugs-eval.csv
