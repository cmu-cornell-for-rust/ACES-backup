Bootstrap: docker
From: ubuntu:25.04

%arguments
    # git branch/commit to build bsan from. Overridden by build.sh's --build-arg
    # when a ref is given; empty default => build from the default branch (main).
    BSAN_REF=""

%environment
    export RUSTUP_HOME=/opt/rust/rustup
    export CARGO_HOME=/opt/rust/cargo
    export PATH=/opt/rust/cargo/bin:$PATH
    export USER="${USER:-$(id -un)}"
    # Point cargo-bsan at the sysroot we pre-built at image-build time. Without
    # this, every `cargo bsan` invocation rebuilds the instrumented sysroot --
    # and under run_job.sh's `--cleanenv` + ephemeral scratch it would rebuild
    # on every single job (slow, and a corrupt/partial rebuild segfaults).
    export BSAN_SYSROOT=/opt/bsan-sysroot
    # Symbolizer so aliasing-violation reports show source locations.
    export BSAN_SYMBOLIZER=/opt/rust/rustup/toolchains/bsan/bin/llvm-symbolizer
    # clang-sys/bindgen (pulled in by crates with C bindings) need llvm-config +
    # libclang. Point the well-known env vars at the LLVM 19 install from %post
    # and put its bin on PATH; these resolve even under run_job.sh's --cleanenv
    # (host env is stripped, but %environment still runs). The versioned clang
    # binaries bsan/crates invoke by name (clang-19 .. clang-22) are also on PATH.
    export LLVM_CONFIG_PATH=/usr/lib/llvm-19/bin/llvm-config
    export LIBCLANG_PATH=/usr/lib/llvm-19/lib
    export PATH=/usr/lib/llvm-19/bin:$PATH

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive

    # --- System packages (mirrors the project's .devcontainer Dockerfile) ----
    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        clang \
        clang-tidy \
        clang-format \
        ninja-build \
        curl \
        vim \
        pkg-config \
        libssl-dev \
        sudo \
        git \
        gdb \
        ca-certificates \
        jq \
        libfontconfig1-dev \
        libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

    # --- LLVM / Clang (a range of recent versions) ---------------------------
    # bsan's toolchain links with a bundled clang (currently clang-22, under
    # /opt/rust/rustup/toolchains/bsan/bin), but build steps and some crates also
    # invoke a versioned *system* clang by name (e.g. clang-19), and bindgen-based
    # crates pull in clang-sys, which needs `llvm-config` + `libclang.so`. Ubuntu
    # 25.04 ships only one default `clang`, so install a spread from apt.llvm.org
    # so whichever `clang-NN` is requested exists on PATH, plus the -dev bits
    # (llvm-config + libclang) that clang-sys/bindgen need.
    apt-get update && apt-get install -y wget gnupg lsb-release software-properties-common
    wget -qO /tmp/llvm.sh https://apt.llvm.org/llvm.sh
    chmod +x /tmp/llvm.sh
    for v in 19 20 21 22; do
        /tmp/llvm.sh "$v" || echo "WARN: LLVM $v unavailable from apt.llvm.org; skipping"
    done
    # clang-sys/bindgen need one llvm-config + libclang; libclang is
    # forward-compatible, and 19 is the safe match for the old clang-sys 0.28
    # some crates pin. The %environment LLVM_CONFIG_PATH/LIBCLANG_PATH point here.
    apt-get install -y llvm-19-dev libclang-19-dev
    rm -f /tmp/llvm.sh
    rm -rf /var/lib/apt/lists/*

    # Use clang as the default C/C++ compiler (matches the dev container).
    update-alternatives --install /usr/bin/cc  cc  /usr/bin/clang   100
    update-alternatives --install /usr/bin/c++ c++ /usr/bin/clang++ 100

    # Install Rust into a fixed, world-readable location so the toolchain works
    # on a read-only container FS without per-user rustup state.
    export RUSTUP_HOME=/opt/rust/rustup
    export CARGO_HOME=/opt/rust/cargo
    export PATH=/opt/rust/cargo/bin:$PATH

    # --- Rust toolchains -----------------------------------------------------
    # Superset of base-miri.def's toolchains/targets, plus what bsan needs.
    # base-miri pins nightly-2026-06-01 as the initial default; xb additionally
    # needs the rolling `nightly` toolchain (its wrapper builds bsan-script with
    # `+nightly` for -Zroot-dir until the `bsan` toolchain exists).
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --no-modify-path --default-toolchain nightly-2026-06-01

    rustup toolchain install nightly --profile default
    rustup toolchain install stable --profile default \
        --target i686-unknown-linux-musl \
        --target x86_64-unknown-linux-gnu
    rustup toolchain install 1.85 --profile default \
        --target i686-unknown-linux-musl \
        --target x86_64-unknown-linux-gnu

    cargo install rustup-toolchain-install-master

    # --- Clone & build BorrowSanitizer --------------------------------------
    # BSAN_REF is supplied by build.sh via --build-arg. When non-empty, check
    # out that branch/commit; otherwise build from the default branch (main).
    BSAN_REF="{{ BSAN_REF }}"
    if [ -n "$BSAN_REF" ]; then
        git clone https://github.com/BorrowSanitizer/bsan /opt/bsan
        git -C /opt/bsan checkout "$BSAN_REF"
    else
        git clone --depth 1 https://github.com/BorrowSanitizer/bsan /opt/bsan
    fi
    cd /opt/bsan

    # --- Patch: tolerate bsan's link flag on compile-only C steps ------------
    # bsan_cflags() (cargo-bsan/src/phases.rs) unconditionally adds
    # `-fuse-ld=...` (a *linker* flag) to CFLAGS/CXXFLAGS for every C-dep build,
    # including compile-only (`-c`) probes. Crates that compile those probes with
    # `-Werror` (e.g. aws-lc-sys) then die on clang's
    # -Wunused-command-line-argument. cargo-bsan OVERWRITES CFLAGS, so this can't
    # be fixed from the run environment -- append the suppression to bsan's own
    # default C flags before building it. Guard: fail loudly if upstream renamed
    # the constant so we don't silently ship an unpatched image.
    sed -i \
      's/"-mno-omit-leaf-frame-pointer"\]/"-mno-omit-leaf-frame-pointer", "-Wno-unused-command-line-argument"]/' \
      cargo-bsan/src/phases.rs
    grep -q -- '-Wno-unused-command-line-argument' cargo-bsan/src/phases.rs \
        || { echo "ERROR: failed to patch BSAN_DEFAULT_CFLAGS in cargo-bsan/src/phases.rs (upstream changed?)"; exit 1; }

    # First-time setup, then build & install the `bsan` toolchain into
    # $RUSTUP_HOME/toolchains/bsan. Per upstream docs, `xb setup` must run
    # before `xb install`.
    ./xb setup
    ./xb install

    # Make `bsan` the default toolchain and sanity-check it.
    rustup default bsan
    rustc -vV

    # --- Pre-build the instrumented sysroot ----------------------------------
    # Build it ONCE into a fixed, world-readable path and pin BSAN_SYSROOT to it
    # (see %environment). This is the bsan analogue of pre-building MIRI_SYSROOT:
    # jobs then reuse it instead of rebuilding per run on read-only/ephemeral FS.
    export BSAN_SYSROOT=/opt/bsan-sysroot
    cargo bsan setup
    # Guard: fail the build loudly if the sysroot wasn't actually populated.
    test -d "$BSAN_SYSROOT" && [ -n "$(ls -A "$BSAN_SYSROOT")" ] || \
        { echo "ERROR: bsan sysroot was not built at $BSAN_SYSROOT"; exit 1; }

    # --- Cleanup -------------------------------------------------------------
    # The toolchain now lives under /opt/rust; drop the build tree.
    rm -rf /opt/bsan/target /opt/bsan/bsan-script/target

    chmod -R a+rX /opt/rust /opt/bsan-sysroot
    apt-get clean && rm -rf /var/lib/apt/lists/*

%runscript
    cd /scratch/group/p.cis260229.000/containers/ 2>/dev/null || cd "$HOME"
    exec "$@"

%test
    # Smoke test: prove the install actually instruments & runs, independent of
    # any external dataset. Run with `singularity test bsan.sif`. A clean exit
    # here means the toolchain, runtime, plugin and pre-built sysroot all work;
    # a segfault here means the *install* is broken (not the crate under test).
    set -e
    export BSAN_SYSROOT=/opt/bsan-sysroot
    rustup default bsan >/dev/null 2>&1 || true
    rustc -vV

    tmp="$(mktemp -d)"
    export CARGO_HOME="$tmp/cargo"
    export CARGO_TARGET_DIR="$tmp/target"
    cargo new --lib "$tmp/bsan_smoke" >/dev/null
    cat >> "$tmp/bsan_smoke/src/lib.rs" <<'RS'

#[test]
fn heap_roundtrip() {
    // Exercises allocation + pointer use so the bsan runtime is actually hit.
    let v = vec![1_i32, 2, 3];
    let p = v.as_ptr();
    assert_eq!(unsafe { *p.add(2) }, 3);
    assert_eq!(v.iter().sum::<i32>(), 6);
}
RS
    cd "$tmp/bsan_smoke"
    cargo bsan test
    echo "BSAN SMOKE TEST: OK"

