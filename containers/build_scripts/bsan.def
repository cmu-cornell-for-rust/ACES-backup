Bootstrap: docker
# Upstream's own tested release image (the exact artifact their CI publishes).
# Use this as ground truth: if `cargo bsan test` segfaults the SAME way here as
# in our from-source bsan.sif, the install is fine and the segfaults are bsan
# itself (its README calls the project "work-in-progress / not functional yet").
# Tags: `latest` (main) or `sha-<short-commit>` for a specific commit.
From: ghcr.io/borrowsanitizer/bsan:latest

%environment
    # The upstream image installs the toolchain under /root, not /opt. rustup
    # honors RUSTUP_HOME directly, so this works under `--cleanenv` even though
    # run_job.sh doesn't set HOME. CARGO_HOME is overridden to scratch at run
    # time by run_job.sh; the value here only matters during %post.
    export RUSTUP_HOME=/root/.rustup
    export CARGO_HOME=/root/.cargo
    export PATH=/root/.cargo/bin:$PATH
    export USER="${USER:-$(id -un)}"
    export BSAN_SYSROOT=/opt/bsan-sysroot
    export BSAN_SYMBOLIZER=/root/.rustup/toolchains/bsan/bin/llvm-symbolizer

%post
    set -eux
    export RUSTUP_HOME=/root/.rustup
    export CARGO_HOME=/root/.cargo
    export PATH=/root/.cargo/bin:$PATH

    rustup default bsan
    rustc -vV

    # Pre-build the instrumented sysroot once into a fixed path (see bsan.def for
    # the rationale: avoids per-job rebuilds under --cleanenv + ephemeral scratch).
    export BSAN_SYSROOT=/opt/bsan-sysroot
    cargo bsan setup
    test -d "$BSAN_SYSROOT" && [ -n "$(ls -A "$BSAN_SYSROOT")" ] || \
        { echo "ERROR: bsan sysroot was not built at $BSAN_SYSROOT"; exit 1; }
    chmod -R a+rX /opt/bsan-sysroot

%runscript
    cd /scratch/group/p.cis260229.000/containers/ 2>/dev/null || cd "$HOME"
    exec "$@"

%test
    set -e
    export BSAN_SYSROOT=/opt/bsan-sysroot
    rustup default bsan >/dev/null 2>&1 || true
    rustc -vV
    tmp="$(mktemp -d)"
    export CARGO_HOME="$tmp/cargo"
    export CARGO_TARGET_DIR="$tmp/target"
    cargo new --lib "$tmp/bsan_smoke" >/dev/null
    cat >> "$tmp/bsan_smoke/src/lib.rs" <<'RS'

#[test]
fn heap_roundtrip() {
    let v = vec![1_i32, 2, 3];
    let p = v.as_ptr();
    assert_eq!(unsafe { *p.add(2) }, 3);
    assert_eq!(v.iter().sum::<i32>(), 6);
}
RS
    cd "$tmp/bsan_smoke"
    cargo bsan test
    echo "BSAN SMOKE TEST: OK"
