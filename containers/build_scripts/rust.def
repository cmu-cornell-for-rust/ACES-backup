Bootstrap: docker
From: ubuntu:22.04

%environment
    export RUSTUP_HOME=/opt/rust/rustup
    export CARGO_HOME=/opt/rust/cargo
    export PATH=/opt/rust/cargo/bin:$PATH

%post
    apt-get update && apt-get install -y \
        curl build-essential ca-certificates \
        git pkg-config libssl-dev jq \
        libfontconfig1-dev libfreetype6-dev

    export RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo PATH=/opt/rust/cargo/bin:$PATH

    # Same pinned nightly as base-miri (opt-in via `cargo +nightly-2026-06-01 ...`);
    # the default is switched to the `miri` toolchain below.
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --no-modify-path --default-toolchain nightly-2026-06-01
    rustup toolchain install stable --profile default \
        --target i686-unknown-linux-musl \
        --target x86_64-unknown-linux-gnu
    rustup toolchain install 1.85 --profile default \
        --target i686-unknown-linux-musl \
        --target x86_64-unknown-linux-gnu

    cargo install rustup-toolchain-install-master --version 1.12.0

    # hyperfine: benchmark runner used by run_bench_dataset.sh.
    cargo +stable install --locked hyperfine --version 1.19.0

    MIRI_RUST_VERSION=$(curl -sSfL https://raw.githubusercontent.com/cmu-cornell-for-rust/miri/master/rust-version)
    test -n "$MIRI_RUST_VERSION" || { echo "ERROR: could not fetch miri fork's rust-version"; exit 1; }
    echo "$MIRI_RUST_VERSION" > /opt/rust/rust-version
    rustup-toolchain-install-master "$MIRI_RUST_VERSION" -n miri \
        --component cargo --component rust-src --component clippy --component rustfmt
    rustup default miri

    chmod -R a+rX /opt/rust
    apt-get clean && rm -rf /var/lib/apt/lists/*

%labels
    Description Rust toolchain pinned to the miri fork's rust-version commit (named `miri`, default), plus nightly-2026-06-01, read-only at /opt/rust



