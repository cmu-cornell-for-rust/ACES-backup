Bootstrap: docker-library://ubuntu:22.04

%labels
    Author BorrowSanitizer / ACES big-apps
    Version 1.0

%environment
    export DEBIAN_FRONTEND=noninteractive
    export RUSTUP_HOME=/opt/rustup
    export CARGO_HOME=/opt/cargo
    export PATH=/opt/cargo/bin:$PATH
    export CC=clang
    export CXX=clang++

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates clang clang-tidy cmake curl git \
        ninja-build pkg-config python3 python3-pip unzip wget \
        libfontconfig-dev libfreetype-dev libsqlite3-dev libgit2-dev libseccomp-dev \
        && rm -rf /var/lib/apt/lists/*

    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly
    rustup component add rust-src rustfmt clippy

    # hyperfine: benchmark runner used by run_bench_dataset.sh. The rustup
    # install above lands in $HOME (%environment's /opt paths only apply at
    # run time), so use that cargo and copy the binary somewhere always on PATH.
    "$HOME/.cargo/bin/cargo" install --locked hyperfine --version 1.19.0
    install -m 0755 "$HOME/.cargo/bin/hyperfine" /usr/local/bin/hyperfine

%runscript
    exec /bin/bash "$@"
