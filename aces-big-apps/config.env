# Shared ACES paths for the p.cis260229.000 group.
# Source this file from scripts:  source "$(dirname "$0")/../config.env"

ACES_USER="${ACES_USER:-u.ra353315}"
ACES_ACCOUNT="${ACES_ACCOUNT:-p.cis260229.000}"
SLURM_ACCOUNT="${SLURM_ACCOUNT:-158460239852}"

GROUP_ROOT="/scratch/group/${ACES_ACCOUNT}"
USER_SCRATCH="/scratch/user/${ACES_USER}"
USER_HOME="/home/${ACES_USER}"

GROUP_CONTAINERS="${GROUP_ROOT}/containers"
GROUP_SCRIPTS="${GROUP_ROOT}/scripts"
GROUP_DATASETS="${GROUP_ROOT}/datasets"
GROUP_OUTPUTS="${GROUP_ROOT}/outputs"

_ACES_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ACES_ROOT="${ACES_ROOT:-${_ACES_CONFIG_DIR}}"

CARGO_TEMP="${CARGO_TEMP:-${USER_SCRATCH}/cargo-temp-${ACES_USER}}"
RUSTUP_HOME="${RUSTUP_HOME:-${CARGO_TEMP}/rustup}"
CARGO_HOME="${CARGO_HOME:-${CARGO_TEMP}/cargo}"

BSAN_REPO="${BSAN_REPO:-https://github.com/BorrowSanitizer/bsan.git}"
BSAN_BRANCH="${BSAN_BRANCH:-main}"
BSAN_DIR="${BSAN_DIR:-${USER_SCRATCH}/bsan}"

APPS_DIR="${APPS_DIR:-${USER_SCRATCH}/big-apps}"
OUTPUT_DIR="${OUTPUT_DIR:-${ACES_ROOT}/outputs/bsan-big-apps}"
BSAN_IMAGE="${BSAN_IMAGE:-${GROUP_CONTAINERS}/bsan.sif}"
BSAN_SERVO_IMAGE="${BSAN_SERVO_IMAGE:-${USER_SCRATCH}/containers/bsan-servo.sif}"

# ACES compute jobs often inherit unlimited stack (ulimit -s unlimited). Linux then
# places mmap/loader mappings differently and they can overlap BSAN/DFSan shadow
# and origin ranges. Any reasonable finite soft stack limit avoids that layout clash;
# 8192 KiB here means 8 MiB (a typical distro default), not 8 KiB.
# Set BSAN_STACK_UNLIMITED=1 to skip bounding (for repro/debug only).
BSAN_STACK_KB="${BSAN_STACK_KB:-8192}"
